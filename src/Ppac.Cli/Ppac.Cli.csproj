<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>ppac</AssemblyName>
    <RootNamespace>Ppac.Cli</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ppac</ToolCommandName>
    <PackageId>Ppac.Cli</PackageId>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Description>Command-line tool for Power Platform admin center (PPAC) tasks.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ppac.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.92.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

</Project>